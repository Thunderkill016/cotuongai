{
  "name": "xiangqi-coach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx scripts/serve.ts",
    "start": "node --env-file-if-exists=.env --import tsx scripts/serve.ts --production",
    "prepare:engine": "node scripts/prepare-engine.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run prepare:engine && vite build",
    "format": "prettier --write src scripts tests *.json *.ts *.md index.html",
    "format:check": "prettier --check src scripts tests *.json *.ts *.md index.html",
    "quality": "npm run typecheck && npm test && npm run format:check && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.3",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.1.5",
    "vitest": "3.2.4"
  }
}
